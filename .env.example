APP_ENV=development
DEBUG=false
AUTO_CREATE_SCHEMA=false
SEED_DEMO=false

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT.supabase.co:5432/postgres
RESERVATION_LAB_BOOKING_ENABLED=true
DEFAULT_RESTAURANT_ID=r1
VOICE_AUDIO_RETENTION_DAYS=7
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
JWT_SECRET=replace-with-a-32-byte-or-longer-secret
PII_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
DEFAULT_TIMEZONE=Europe/Rome
DEFAULT_PHONE_REGION=IT
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=120
RATE_LIMIT_AUTH_REQUESTS_PER_WINDOW=20
RATE_LIMIT_SENSITIVE_REQUESTS_PER_WINDOW=60
RATE_LIMIT_PUBLIC_REQUESTS_PER_WINDOW=120
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

TOOL_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_WEB_BASE_URL=http://127.0.0.1:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
NOTIFICATION_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Supabase production example:
# APP_ENV=production
# AUTO_CREATE_SCHEMA=false
# SEED_DEMO=false
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# SESSION_COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://dashboard.yourdomain.com
# PUBLIC_BASE_URL=https://api.yourdomain.com
# PUBLIC_WEB_BASE_URL=https://dashboard.yourdomain.com
